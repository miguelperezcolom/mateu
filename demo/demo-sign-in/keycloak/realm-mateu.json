{
  "realm": "mateu",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "mateu-ui",
      "name": "Mateu UI (demo-sign-in)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8081/*"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "staff"
      }
    ]
  },
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "López",
      "email": "ana@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "ana",
          "temporary": false
        }
      ],
      "realmRoles": [
        "staff",
        "default-roles-mateu"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:}",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email"
      }
    }
  ]
}
