<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>mateu-native-demo</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>mateu-native-demo</name>
    <description>The public Mateu native demo: Quarkus native on Cloud Run, products in Firestore, Redwood renderer.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
        <lombok.version>1.18.40</lombok.version>
        <!-- The latest Mateu release on Maven Central. To build against your local checkout instead,
             install the backend (cd backend && mvn install -DskipTests) and pass
             -Dmateu.version=0.0.1-MATEU -->
        <mateu.version>3.0.7</mateu.version>
        <quarkus-mateu.version>1.1.0</quarkus-mateu.version>
        <!-- The renderer: Mateu's default (Vaadin-based) one. `-Predwood` swaps it for the Redwood
             renderer with no change to the classes; front/build-site.sh uses that for the Netlify site. -->
        <mateu.renderer>mateu-vaadin</mateu.renderer>
        <mateu.unused-renderer>mateu-redwood</mateu.unused-renderer>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.mateu</groupId>
                <artifactId>mateu-bom</artifactId>
                <version>${mateu.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.mateu</groupId>
            <artifactId>quarkus-mateu</artifactId>
            <version>${quarkus-mateu.version}</version>
            <!-- the extension brings the default renderer; the redwood profile leaves it out -->
            <exclusions>
                <exclusion>
                    <groupId>io.mateu</groupId>
                    <artifactId>${mateu.unused-renderer}</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>${mateu.renderer}</artifactId>
        </dependency>
        <!-- Google Cloud Firestore (native-ready), where ProductStore keeps the products -->
        <dependency>
            <groupId>io.quarkiverse.googlecloudservices</groupId>
            <artifactId>quarkus-google-cloud-firestore</artifactId>
            <version>2.25.1</version>
        </dependency>
        <!-- The generated controllers use Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <parameters>true</parameters>
                    <!-- REQUIRED: the Mateu annotation processor generates one JAX-RS resource per
                         @UI class. List every processor you use here (Lombok too). -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.mateu</groupId>
                            <artifactId>mateu-annotation-processor-quarkus</artifactId>
                            <version>${mateu.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>redwood</id>
            <properties>
                <mateu.renderer>mateu-redwood</mateu.renderer>
                <mateu.unused-renderer>mateu-vaadin</mateu.unused-renderer>
            </properties>
        </profile>
    </profiles>
</project>
