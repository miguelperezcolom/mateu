<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.mateu.mdd</groupId>
    <artifactId>demo-vb-pms</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>demo-vb-pms</name>
    <description>PMS de referencia tipo OPERA Cloud sobre el renderer Redwood (io.mateu:mateu-redwood):
        pantallas que imitan las de OPERA con datos ficticios en memoria y sin lógica de negocio real,
        para verificar que Redwood dibuja lo que un PMS necesita (Room Diary, Property Availability,
        búsqueda en consola, detalle de reserva, check-in, facturación, pisos, calendario, dashboard,
        cierre del día). Puerto 9010, CORS abierto para la app VB en desarrollo (vb-serve :9006).</description>
    <properties>
        <!-- Tracks master: install the backend first (cd backend && mvn install -DskipTests).
             This demo uses features newer than the last release. -->
        <mateu.version>0.0.1-MATEU</mateu.version>
        <mateu.renderer>mateu-redwood</mateu.renderer>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- here mateu dependencies -->
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mateu-annotation-processor-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mateu-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- exportación a Excel de los listados (Listing.excelExportable) -->
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mateu-export-excel</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- el renderer VB/Redwood empaquetado: sirve la app VB optimizada en la raíz -->
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>${mateu.renderer}</artifactId>
            <version>${mateu.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                                <path>
                                    <groupId>io.mateu</groupId>
                                    <artifactId>mateu-annotation-processor-mvc</artifactId>
                                    <version>${mateu.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                                <path>
                                    <groupId>io.mateu</groupId>
                                    <artifactId>mateu-annotation-processor-mvc</artifactId>
                                    <version>${mateu.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>

