<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.demo</groupId>
    <artifactId>demo-static-vcn-yaml</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>demo-static-vcn-yaml</name>
    <description>The static VCN slice authored as YAML definitions, shipped RAW and expanded in the
        browser (specs mode) — no backend, no pre-rendering.</description>

    <properties>
        <java.version>21</java.version>
        <mateu.version>0.0.1-MATEU</mateu.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mvc-core</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>vaadin-lit</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn -Pbundle package → target/mateu-bundle/: index.html + manifest.json + assets/.
             staticOnly: every route must be static-safe (the build fails otherwise) and the
             definition-only routes ship as RAW definitions the browser expands — nothing is
             pre-rendered. -->
        <profile>
            <id>bundle</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.mateu</groupId>
                        <artifactId>mateu-bundle-maven-plugin</artifactId>
                        <version>${mateu.version}</version>
                        <configuration>
                            <assetsFrom>${project.basedir}/../../../backend/shared/frontend/vaadin-lit/src/main/resources/static</assetsFrom>
                            <basePackages>io.mateu.demo.staticvcn.yaml</basePackages>
                            <pageTitle>Networking (static, YAML)</pageTitle>
                            <skipParamRoutes>false</skipParamRoutes>
                            <staticOnly>true</staticOnly>
                            <specsOnly>true</specsOnly>
                        </configuration>
                        <executions>
                            <execution>
                                <id>bundle</id>
                                <goals>
                                    <goal>bundle</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
