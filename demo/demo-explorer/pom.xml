<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.demo</groupId>
    <artifactId>demo-explorer</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>demo-explorer</name>
    <description>The Mateu Explorer: a Mateu app that shows everything Mateu can do — every component,
        page template, archetype, behaviour and distributed-UI pattern — each running live, next to
        the very source that renders it (read from the classpath, never copied by hand).</description>

    <properties>
        <java.version>21</java.version>
        <!-- Latest Mateu release on Maven Central. -->
        <mateu.version>3.0-beta.58</mateu.version>
        <!-- Which renderer serves the UI: mateu-vaadin (default) or mateu-redwood.
             mvn spring-boot:run -Dmateu.renderer=mateu-redwood -->
        <mateu.renderer>mateu-vaadin</mateu.renderer>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mateu-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>${mateu.renderer}</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.mateu</groupId>
                            <artifactId>mateu-annotation-processor-mvc</artifactId>
                            <version>${mateu.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- SINGLE SOURCE OF TRUTH for the "Code" tabs: the module's own sources (the Java
                 examples, the YAML that renders the live examples, the C#/Python port snippets) are
                 copied VERBATIM into the jar under explorer-src/, at the same relative path they
                 have in this module. The entry page reads them from there — what it shows is what
                 was compiled and what runs, never a hand-kept copy. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>explorer-sources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/explorer-src</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>src/main/java/io/mateu/explorer/examples/**</include>
                                        <include>src/main/resources/specs/ui/**</include>
                                        <include>src/main/resources/application.properties</include>
                                        <include>src/main/ports/**</include>
                                        <!-- the remote apps of the Distributed UIs area -->
                                        <include>remotes/**</include>
                                    </includes>
                                    <excludes>
                                        <exclude>remotes/**/target/**</exclude>
                                        <exclude>remotes/**/.venv/**</exclude>
                                        <exclude>remotes/**/__pycache__/**</exclude>
                                        <exclude>remotes/**/*.log</exclude>
                                        <exclude>remotes/.pids</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
