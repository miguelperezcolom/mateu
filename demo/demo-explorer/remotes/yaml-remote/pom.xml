<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.demo.explorer</groupId>
    <artifactId>explorer-yaml-remote</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>explorer-yaml-remote</name>
    <description>The Explorer's YAML-only remote (default port 8642): an Orders domain mounted at
        /orders, with no UI code at all — the mount, its app shell, its routes and its pages are YAML
        under specs/ui. The only Java is the Spring Boot main.</description>

    <properties>
        <java.version>21</java.version>
        <mateu.version>3.0-beta.51</mateu.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mateu-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mateu-vaadin</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
