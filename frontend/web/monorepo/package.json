{
  "name": "monorepo",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "test": "yarn workspace mateu test",
    "lint": "eslint libs/mateu/src apps/vaadin/src --max-warnings 376"
  },
  "resolutions": {
    "@vaadin/*": "~25.3.3"
  },
  "overrides": {
    "@vaadin/*": "~25.3.3",
    "adm-zip": "^0.6.1",
    "lodash": "^4.18.1",
    "js-yaml@<3.15.2": "^3.15.2",
    "minimatch@<3.1.3": "^3.1.5",
    "braces@<3.0.3": "^3.0.3",
    "form-data@<2.5.6": "^2.5.6",
    "qs@<6.14.1": "^6.14.1",
    "tough-cookie@<4.1.3": "^4.1.3",
    "tar-fs@<2.1.4": "^2.1.4",
    "ws@>=8.0.0 <8.21.0": "^8.21.0",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "//overrides": [
    "Security overrides for transitive deps the direct deps cannot move yet (see SECURITY-DEPENDENCIES.md at the repo root).",
    "@vaadin/*: pre-existing version alignment, not security.",
    "adm-zip: #528 #629 #657 #710 #714. lodash: #326 #327 #516.",
    "js-yaml 3.x: #527 #529 #575 #653. minimatch 3.x: #520. braces 2.x: #507.",
    "form-data 2.x: #512 #526. qs: #514. tough-cookie 2.x: #506. tar-fs: #510 #511 #513. ws 8.x: #508 #525.",
    "serialize-javascript: #521 #524.",
    "Almost all of them come from the Oracle VB grunt tooling of apps/redwood (dev-only, never shipped)."
  ]
}
