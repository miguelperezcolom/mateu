{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@mateu/*": ["../../libs/mateu/src/mateu/*"],
      "@application/*": ["../../libs/mateu/src/mateu/ui/application/*"],
      "@domain/*": ["../../libs/mateu/src/mateu/ui/domain/*"],
      "@infra/*": ["../../libs/mateu/src/mateu/ui/infra/*"],
      "@components/*": ["../../libs/mateu/src/mateu/ui/infra/ui/*"]
    }
  },
  "include": ["src"]
}
