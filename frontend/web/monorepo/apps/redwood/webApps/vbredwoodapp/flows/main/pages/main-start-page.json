{
  "title": "",
  "description": "Contenido alimentado por Mateu: t\u00edtulo + form / listado + drawer del crud; la carga la orquesta la shell",
  "variables": {
    "mateuColumnsModel": {
      "type": "any",
      "defaultValue": [],
      "description": "diálogo de columnas del listado: [{id, label, visible}] en el orden elegido"
    },
    "mateuViewsMenu": {
      "type": "any",
      "defaultValue": [],
      "description": "menú de vistas guardadas del listado: [{value, label}]"
    },
    "mateuViewName": {
      "type": "string",
      "defaultValue": "",
      "description": "nombre de la vista que se va a guardar"
    },
    "mateuViewDefault": {
      "type": "boolean",
      "defaultValue": false,
      "description": "la vista que se guarda será la de por defecto"
    },
    "listingADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $application.variables.mateuListingRows }}",
        "keyAttributes": "_rowNumber"
      },
      "description": "envuelve las filas del listing de Mateu para oj-table (_rowNumber siempre presente)"
    },
    "mateuDraft": {
      "type": "any",
      "defaultValue": {},
      "description": "edici\u00f3n en curso del form del host ({fieldId: valor})"
    },
    "mateuDrawerDraft": {
      "type": "any",
      "defaultValue": {},
      "description": "edici\u00f3n en curso del form del drawer"
    },
    "mateuToastText": {
      "type": "string",
      "defaultValue": ""
    },
    "mateuIslandDraft": {
      "type": "any",
      "defaultValue": {},
      "description": "edici\u00f3n en curso del form de la isla"
    },
    "overviewADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $application.variables.mateuOverviewOptions }}",
        "keyAttributes": "value"
      }
    },
    "welcomeTrendADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $application.variables.mateuWelcomeTrendItems }}",
        "keyAttributes": "id"
      },
      "description": "items del chart de previsi\u00f3n de la welcome para el oj-chart"
    },
    "overviewSelectConfig": {
      "type": "any",
      "defaultValue": {
        "data": "{{ $page.variables.overviewADP }}",
        "itemText": "label",
        "labelHint": "Record"
      },
      "description": "selectObject del header-general-overview (el DataProvider va DENTRO del objeto)"
    },
    "mateuProgressTitle": {
      "type": "string",
      "defaultValue": ""
    },
    "mateuProgressText": {
      "type": "string",
      "defaultValue": ""
    },
    "mateuProgressValue": {
      "type": "number",
      "defaultValue": 0
    },
    "mateuModalOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "mateuRowEditor": {
      "type": "any",
      "defaultValue": {
        "id": "",
        "fieldId": "",
        "title": "",
        "subtitle": "",
        "toolbar": [],
        "buttons": [],
        "fields": []
      },
      "description": "editor de fila abierto de una lista modal (bridge.rowEditorOf)"
    },
    "mateuRowDraft": {
      "type": "any",
      "defaultValue": {},
      "description": "edici\u00f3n en curso de la fila del editor modal ({fieldId: valor})"
    },
    "mateuRowErrors": {
      "type": "any",
      "defaultValue": {},
      "description": "obligatorios vac\u00edos de la fila ({fieldId: mensaje})"
    },
    "mateuRowEditorOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "mateuConfirm": {
      "type": "any",
      "defaultValue": {
        "title": "",
        "message": "",
        "confirmText": "",
        "denyText": ""
      },
      "description": "el di\u00e1logo de confirmaci\u00f3n de una acci\u00f3n (bridge.confirmationOf)"
    },
    "mateuPicker": {
      "type": "any",
      "defaultValue": {
        "id": "",
        "title": "",
        "multi": false,
        "searchable": false,
        "searchText": "",
        "columns": [],
        "rows": [],
        "isEmpty": true,
        "emptyText": "",
        "selectionMode": {
          "row": "none"
        },
        "pageSize": 20,
        "paging": {
          "visible": false,
          "prevDisabled": true,
          "nextDisabled": true,
          "rangeText": "",
          "labels": {
            "prev": "",
            "next": ""
          }
        },
        "pickActionId": "",
        "addActionId": "",
        "addLabel": ""
      },
      "description": "el selector de un @Searchable abierto (bridge.searchPickerOf)"
    },
    "mateuPickerRows": {
      "type": "any[]",
      "defaultValue": [],
      "description": "las filas del selector abierto"
    },
    "pickerADP": {
      "type": "vb/ArrayDataProvider2",
      "defaultValue": {
        "data": "{{ $variables.mateuPickerRows }}",
        "keyAttributes": "_rowNumber"
      },
      "description": "las filas del selector de un @Searchable para su oj-table"
    },
    "mateuPickerSelection": {
      "type": "any",
      "defaultValue": {
        "all": false,
        "keys": [],
        "except": []
      },
      "description": "las casillas marcadas en el selector (bridge.selectionOfKeySet)"
    },
    "mateuPickerOpen": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "metadata": {},
  "types": {},
  "chains": {},
  "eventListeners": {
    "mateuFieldChanged": {
      "chains": [
        {
          "parameters": {
            "fieldId": "{{ $current.data.fieldId }}",
            "event": "{{ $event }}"
          },
          "chain": "mateuFieldEdited"
        }
      ]
    },
    "mateuActionClicked": {
      "chains": [
        {
          "parameters": {
            "actionId": "{{ $current.data.actionId }}",
            "parameters": "{{ $current.data.parameters }}",
            "event": "{{ $event }}"
          },
          "chain": "runMateuAction"
        }
      ]
    },
    "mateuRowAction": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "mateuRowClicked"
        }
      ]
    },
    "mateuDrawerClosed": {
      "chains": [
        {
          "chain": "mateuDrawerDismissed"
        }
      ]
    },
    "mateuListingSelectionChanged": {
      "chains": [
        {
          "parameters": {
            "event": "{{ $event }}"
          },
          "chain": "mateuListingSelected"
        }
      ]
    },
    "mateuRowDetailClosed": {
      "chains": [
        {
          "chain": "mateuRowDetailDismissed"
        }
      ]
    },
    "mateuListingPage": {
      "chains": [
        {
          "chain": "listingPaged",
          "parameters": {
            "which": "{{ $event.target.dataset.page }}"
          }
        }
      ]
    },
    "mateuListingSort": {
      "chains": [
        {
          "chain": "listingSorted",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuSearchAction": {
      "chains": [
        {
          "parameters": {
            "searchText": "{{ $event.detail.value }}"
          },
          "chain": "runMateuSearch"
        }
      ]
    },
    "mateuWizardContinue": {
      "chains": [
        {
          "chain": "wizardNext"
        }
      ]
    },
    "mateuWizardPrimaryAction": {
      "chains": [
        {
          "chain": "wizardNext"
        }
      ]
    },
    "mateuWizardStepNavigate": {
      "chains": [
        {
          "chain": "wizardStepNavigate",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuWizardTrainSelect": {
      "chains": [
        {
          "chain": "wizardTrainSelect",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuWizardCancel": {
      "chains": [
        {
          "chain": "wizardCancel"
        }
      ]
    },
    "mateuIslandFieldChanged": {
      "chains": [
        {
          "chain": "islandFieldEdited",
          "parameters": {
            "fieldId": "{{ $current.data.fieldId }}",
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuIslandActionClicked": {
      "chains": [
        {
          "chain": "runMateuIslandAction",
          "parameters": {
            "actionId": "{{ $current.data.actionId }}"
          }
        }
      ]
    },
    "welcomePrimary": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $application.variables.mateuWelcome.primaryCtaId }}"
          }
        }
      ]
    },
    "welcomeSecondary": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $application.variables.mateuWelcome.secondaryCtaId }}"
          }
        }
      ]
    },
    "overviewSwitched": {
      "chains": [
        {
          "chain": "onOverviewSwitch",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuAppTabChanged": {
      "chains": [
        {
          "chain": "appTabSelected",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuAppBack": {
      "chains": [
        {
          "chain": "appTabSelected",
          "parameters": {
            "event": "{{ $event }}",
            "back": "{{ true }}"
          }
        }
      ]
    },
    "mateuContentTabChanged": {
      "chains": [
        {
          "chain": "contentTabSelected",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "itemTabChanged": {
      "chains": [
        {
          "chain": "onItemTabSelected",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "listPrimary": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $application.variables.mateuListPrimaryId }}"
          }
        }
      ]
    },
    "listSecondary": {
      "chains": [
        {
          "chain": "onListSecondary",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuCellEdited": {
      "chains": [
        {
          "chain": "mateuCellEdited",
          "parameters": {
            "event": "{{ $event }}",
            "row": "{{ $current.row }}",
            "item": "{{ $current.item }}",
            "columnIndex": "{{ $current.columnIndex }}"
          }
        }
      ]
    },
    "queueItemClicked": {
      "chains": [
        {
          "chain": "queueItemClicked",
          "parameters": {
            "itemId": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "islandBlockAction": {
      "chains": [
        {
          "chain": "dispatchIslandAction",
          "parameters": {
            "actionId": "{{ $current.data.actionId }}",
            "parameters": "{{ $current.data.parameters }}",
            "fromNested": "{{ $current.data.fromNested }}"
          }
        }
      ]
    },
    "addonToggled": {
      "chains": [
        {
          "chain": "addonToggled",
          "parameters": {
            "event": "{{ $event }}",
            "itemId": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "paymentConfirm": {
      "chains": [
        {
          "chain": "runMateuIslandAction",
          "parameters": {
            "actionId": "{{ $current.data.confirmActionId }}",
            "parameters": "{{ $current.data.confirmParameters }}"
          }
        }
      ]
    },
    "nestedBlockAction": {
      "chains": [
        {
          "chain": "runMateuNestedAction",
          "parameters": {
            "actionId": "{{ $current.data.actionId }}",
            "parameters": "{{ $current.data.parameters }}"
          }
        }
      ]
    },
    "queueRowAction": {
      "chains": [
        {
          "chain": "queueRowAction",
          "parameters": {
            "actionId": "{{ $current.data.actionId }}",
            "parameters": "{{ $current.data.parameters }}"
          }
        }
      ]
    },
    "hostBlockAction": {
      "chains": [
        {
          "chain": "dispatchHostBlockAction",
          "parameters": {
            "actionId": "{{ $current.data.actionId }}",
            "parameters": "{{ $current.data.parameters }}",
            "fromNested": "{{ $current.data.fromNested }}"
          }
        }
      ]
    },
    "hostPaymentConfirm": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $current.data.confirmActionId }}",
            "parameters": "{{ $current.data.confirmParameters }}"
          }
        }
      ]
    },
    "hostAddonToggled": {
      "chains": [
        {
          "chain": "hostAddonToggled",
          "parameters": {
            "event": "{{ $event }}",
            "itemId": "{{ $current.data.id }}"
          }
        }
      ]
    },
    "smartFiltersChanged": {
      "chains": [
        {
          "chain": "smartFiltersChanged",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "hostInputChanged": {
      "chains": [
        {
          "chain": "hostInputChanged",
          "parameters": {
            "event": "{{ $event }}",
            "fieldId": "{{ $current.data.fieldId }}",
            "fromNested": "{{ $current.data.fromNested }}"
          }
        }
      ]
    },
    "headerPrimary": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $application.variables.mateuPageHeader.primaryId }}"
          }
        }
      ]
    },
    "notFoundBack": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "__notFoundBack"
          }
        }
      ]
    },
    "headerGoToParent": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $application.variables.mateuPageHeader.backId }}"
          }
        }
      ]
    },
    "headerSecondary": {
      "chains": [
        {
          "chain": "headerSecondaryAction",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuModalClosed": {
      "chains": [
        {
          "chain": "mateuModalDismissed"
        }
      ]
    },
    "hostInputTyped": {
      "chains": [
        {
          "chain": "hostInputTyped",
          "parameters": {
            "fieldId": "{{ $current.data.fieldId }}",
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "welcomeKpiClicked": {
      "chains": [
        {
          "chain": "runMateuAction",
          "parameters": {
            "actionId": "{{ $current.data.kpiActionId }}"
          }
        }
      ]
    },
    "rowActionClicked": {
      "chains": [
        {
          "chain": "listingRowAction",
          "parameters": {
            "methodName": "{{ $event.target.dataset.method }}",
            "rowId": "{{ $event.target.dataset.rowId }}",
            "rowKey": "{{ $event.target.dataset.rowKey }}"
          }
        }
      ]
    },
    "application:mateuRetryAction": {
      "chains": [
        {
          "parameters": {
            "actionId": "{{ $event.actionId }}",
            "parameters": "{{ $event.parameters }}"
          },
          "chain": "runMateuAction"
        }
      ]
    },
    "planningMoved": {
      "chains": [
        {
          "chain": "planningGanttEvent",
          "parameters": {
            "kind": "move",
            "event": "{{ $event }}",
            "atom": "{{ $current.data }}"
          }
        }
      ]
    },
    "planningResized": {
      "chains": [
        {
          "chain": "planningGanttEvent",
          "parameters": {
            "kind": "resize",
            "event": "{{ $event }}",
            "atom": "{{ $current.data }}"
          }
        }
      ]
    },
    "planningDblClick": {
      "chains": [
        {
          "chain": "planningGanttEvent",
          "parameters": {
            "kind": "open",
            "event": "{{ $event }}",
            "atom": "{{ $current.data }}"
          }
        }
      ]
    },
    "columnsOpen": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "open"
          }
        }
      ]
    },
    "columnsToggle": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "toggle",
            "id": "{{ $event.target.dataset.columnId }}",
            "value": "{{ $event.detail.value }}",
            "updatedFrom": "{{ $event.detail.updatedFrom }}"
          }
        }
      ]
    },
    "columnsUp": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "move",
            "id": "{{ $event.currentTarget.dataset.columnId }}",
            "delta": -1
          }
        }
      ]
    },
    "columnsDown": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "move",
            "id": "{{ $event.currentTarget.dataset.columnId }}",
            "delta": 1
          }
        }
      ]
    },
    "columnsApply": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "apply"
          }
        }
      ]
    },
    "columnsReset": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "reset"
          }
        }
      ]
    },
    "columnsCancel": {
      "chains": [
        {
          "chain": "listingColumns",
          "parameters": {
            "op": "cancel"
          }
        }
      ]
    },
    "viewsBeforeOpen": {
      "chains": [
        {
          "chain": "listingViews",
          "parameters": {
            "op": "menu"
          }
        }
      ]
    },
    "viewsAction": {
      "chains": [
        {
          "chain": "listingViews",
          "parameters": {
            "op": "action",
            "value": "{{ $event.detail.selectedValue }}"
          }
        }
      ]
    },
    "viewSaveConfirm": {
      "chains": [
        {
          "chain": "listingViews",
          "parameters": {
            "op": "save"
          }
        }
      ]
    },
    "viewSaveCancel": {
      "chains": [
        {
          "chain": "listingViews",
          "parameters": {
            "op": "cancelSave"
          }
        }
      ]
    },
    "application:mateuElementEvent": {
      "chains": [
        {
          "parameters": {
            "actionId": "{{ $event.actionId }}",
            "parameters": "{{ $event.parameters }}",
            "fromNested": "{{ $event.fromNested }}"
          },
          "chain": "dispatchHostBlockAction"
        }
      ]
    },
    "mateuListAction": {
      "chains": [
        {
          "chain": "mateuListAction",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuRowFieldChanged": {
      "chains": [
        {
          "chain": "mateuRowFieldEdited",
          "parameters": {
            "fieldId": "{{ $current.data.fieldId }}",
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuRowEditorClosed": {
      "chains": [
        {
          "chain": "mateuRowEditorDismissed"
        }
      ]
    },
    "mateuConfirmAccept": {
      "chains": [
        {
          "chain": "mateuConfirmAnswered",
          "parameters": {
            "confirmed": true
          }
        }
      ]
    },
    "mateuConfirmDeny": {
      "chains": [
        {
          "chain": "mateuConfirmAnswered",
          "parameters": {
            "confirmed": false
          }
        }
      ]
    },
    "mateuConfirmClosed": {
      "chains": [
        {
          "chain": "mateuConfirmAnswered",
          "parameters": {
            "confirmed": false,
            "closing": true
          }
        }
      ]
    },
    "searchableChipRemoved": {
      "chains": [
        {
          "chain": "searchableChipRemoved",
          "parameters": {
            "fieldId": "{{ $current.data.fieldId }}",
            "remaining": "{{ $current.data.remaining }}"
          }
        }
      ]
    },
    "mateuPickerRowAction": {
      "chains": [
        {
          "chain": "mateuPickerRowClicked",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuPickerSelectionChanged": {
      "chains": [
        {
          "chain": "mateuPickerSelected",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuPickerAdd": {
      "chains": [
        {
          "chain": "mateuPickerAdd"
        }
      ]
    },
    "mateuPickerSearch": {
      "chains": [
        {
          "chain": "mateuPickerSearch",
          "parameters": {
            "searchText": "{{ $event.detail.value }}"
          }
        }
      ]
    },
    "mateuPickerPage": {
      "chains": [
        {
          "chain": "mateuPickerSearch",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "mateuPickerCancel": {
      "chains": [
        {
          "chain": "mateuPickerDismissed",
          "parameters": {
            "cancel": true
          }
        }
      ]
    },
    "mateuPickerClosed": {
      "chains": [
        {
          "chain": "mateuPickerDismissed"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-form-layout": {
        "path": "ojs/ojformlayout"
      },
      "oj-input-text": {
        "path": "ojs/ojinputtext"
      },
      "oj-input-number": {
        "path": "ojs/ojinputnumber"
      },
      "oj-switch": {
        "path": "ojs/ojswitch"
      },
      "oj-button": {
        "path": "ojs/ojbutton"
      },
      "oj-sp-messages-toast": {
        "path": "oj-sp/messages-toast/loader"
      },
      "oj-table": {
        "path": "ojs/ojtable"
      },
      "oj-input-search": {
        "path": "ojs/ojinputsearch"
      },
      "oj-sp-empty-state": {
        "path": "oj-sp/empty-state/loader"
      },
      "oj-drawer-popup": {
        "path": "ojs/ojdrawerpopup"
      },
      "oj-sp-foldout-layout": {
        "path": "oj-sp/foldout-layout/loader"
      },
      "oj-sp-foldout-panel": {
        "path": "oj-sp/foldout-panel/loader"
      },
      "oj-sp-guided-process": {
        "path": "oj-sp/guided-process/loader"
      },
      "oj-sp-header-welcome-banner": {
        "path": "oj-sp/header-welcome-banner/loader"
      },
      "oj-sp-header-general-overview": {
        "path": "oj-sp/header-general-overview/loader"
      },
      "oj-tab-bar": {
        "path": "ojs/ojtabbar"
      },
      "oj-sp-smart-filter-search": {
        "path": "oj-sp/smart-filter-search/loader"
      },
      "oj-action-card": {
