{
    "name": "mateu-redwood",
    "version": "2604.1.0",
    "private": true,
    "description": "Mateu renderer sobre Oracle Visual Builder / Redwood (app VB + bridge)",
    "scripts": {
        "bridge": "node poc/make-amd.mjs",
        "test": "cd poc && node test.mjs",
        "build": "grunt vb-build --no-optimize=true --force",
        "serve": "grunt vb-serve --port=9006",
        "copy": "node scripts/copy.mjs"
    },
    "devDependencies": {
        "@oracle/grunt-vb-audit": "https://static.oracle.com/cdn/vb/tools/npm/grunt-vb-audit/grunt-vb-audit-2510.0.0.tar.gz",
        "@oracle/grunt-vb-build": "https://static.oracle.com/cdn/vb/tools/npm/grunt-vb-build/grunt-vb-build-2510.4.0.tar.gz",
        "grunt": "^1.0.3",
        "grunt-cli": "^1.3.2",
        "load-grunt-tasks": "^4.0.0"
    },
    "com_oracle_visual_builder": {
        "upgrade": "micro"
    }
}
