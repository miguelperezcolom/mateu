<idea-plugin>
    <id>io.mateu.ijp.plugin</id>
    <name>Mateu</name>
    <vendor email="miguelperezcolom@gmail.com" url="https://mateu.io">Mateu</vendor>
    <description><![CDATA[
<p>Tooling for <a href="https://mateu.io">Mateu</a>, the model-driven UI system: declare the UI once
(Java/C#/Python classes or YAML under <code>specs/ui/</code>) and Mateu renders it everywhere.</p>
<ul>
  <li><b>Authoring</b>: schema validation and completion for <code>specs/ui/**</code> YAML, a visual
      editor (palette, WYSIWYG canvas, properties), binding checks against the Java view model with
      quick fixes, and <b>New | Mateu</b> file templates for every specs kind.</li>
  <li><b>Running</b>: renders a Mateu app inside the IDE with native components &mdash; a navigator tool
      window, listings in a results panel, pages and details as editor tabs.</li>
</ul>
<p>Point a project at its backend in <b>Settings | Tools | Mateu</b> (base URL or app registry, plus
token or OpenID Connect sign-in). Projects without a Mateu backend are left untouched.</p>
<p><b>Requires a Java IDE</b> (IntelliJ IDEA Community or Ultimate, or another IDE bundling the Java and
YAML plugins): the binding checks resolve view models through Java PSI.</p>
]]></description>
    <change-notes><![CDATA[
<ul>
  <li>Settings | Tools | Mateu: per-project base URL, start route, app registry and authentication.</li>
  <li>Authentication: bearer token or OpenID Connect device sign-in, stored in the IDE credential
      store; 401 responses trigger a silent refresh or a sign-in prompt.</li>
  <li>No longer takes over the window title, toolbar or tool windows of projects without a Mateu
      backend; the standalone desktop distribution keeps its app-shell behaviour.</li>
  <li>Renders every Mateu wire component type (grids, details, breadcrumbs, avatars, menus,
      carousels, chat, results, BPMN/workflow, cookie consent and more).</li>
  <li>New | Mateu file templates for UI mounts, routes, app shells, REST sources and pages.</li>
</ul>
]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Visual-builder binding validation: squiggles when a YAML page's FormField id / Button
             actionId does not exist on the ModelView the page declares. -->
        <annotator language="yaml"
                   implementationClass="io.mateu.ijp.contract.MateuYamlBindingAnnotator"/>
        <toolWindow id="Mateu" anchor="right" canCloseContents="false"
                    factoryClass="io.mateu.ijp.plugin.MateuToolWindowFactory"
                    icon="/icons/mateu.svg"/>
        <!-- Bottom results panel for CRUD-listing tabs. Declared here (rather than registered at
             runtime) so we never call the override-only ToolWindowManager.registerToolWindow. -->
        <toolWindow id="Mateu Results" anchor="bottom" canCloseContents="true"
                    factoryClass="io.mateu.ijp.plugin.MateuResultsToolWindowFactory"
                    icon="/icons/mateu.svg"/>
        <fileEditorProvider implementation="io.mateu.ijp.plugin.MateuFileEditorProvider"/>
        <!-- Cross-IDE web visual editor (JCEF) for specs/ui/*.yaml pages: palette + WYSIWYG canvas
             + properties in one view. Successor to the retired Swing split-preview. -->
        <fileEditorProvider implementation="io.mateu.ijp.visualeditor.MateuVisualEditorProvider"/>
        <postStartupActivity implementation="io.mateu.ijp.plugin.MateuFocusedModeActivity"/>
        <projectConfigurable parentId="tools" id="io.mateu.settings" displayName="Mateu"
                             instance="io.mateu.ijp.plugin.MateuConfigurable"/>
        <notificationGroup id="Mateu" displayType="BALLOON"/>
        <!-- New | Mateu skeletons (customisable in Settings | Editor | File and Code Templates). Listed in
             /mateu/new-file-kinds.json; NewMateuFileSkeletonsTest keeps the three in sync. -->
        <internalFileTemplate name="Mateu App Shell"/>
        <internalFileTemplate name="Mateu Page Blank"/>
        <internalFileTemplate name="Mateu Page Calendar"/>
        <internalFileTemplate name="Mateu Page Collection Detail"/>
        <internalFileTemplate name="Mateu Page Dashboard"/>
        <internalFileTemplate name="Mateu Page Data Management"/>
        <internalFileTemplate name="Mateu Page Foldout"/>
        <internalFileTemplate name="Mateu Page Form"/>
        <internalFileTemplate name="Mateu Page Gantt"/>
        <internalFileTemplate name="Mateu Page General Overview"/>
        <internalFileTemplate name="Mateu Page Hero Search"/>
        <internalFileTemplate name="Mateu Page Item Overview"/>
        <internalFileTemplate name="Mateu Page Listing"/>
        <internalFileTemplate name="Mateu Page Matrix Grid"/>
        <internalFileTemplate name="Mateu Page Planning Board"/>
        <internalFileTemplate name="Mateu Page Smart Search"/>
        <internalFileTemplate name="Mateu Page Todo List"/>
        <internalFileTemplate name="Mateu Page Welcome"/>
        <internalFileTemplate name="Mateu Page Wizard"/>
        <internalFileTemplate name="Mateu Routes"/>
        <internalFileTemplate name="Mateu Sources"/>
        <internalFileTemplate name="Mateu Actions"/>
        <internalFileTemplate name="Mateu UI Mount"/>
    </extensions>

    <!-- Applies the unified Mateu authoring schema to every specs/ui/**.yaml in the text editor. -->
    <extensions defaultExtensionNs="com.intellij.json">
        <jsonSchemaProviderFactory implementation="io.mateu.ijp.schema.MateuSchemaProviderFactory"/>
    </extensions>

    <actions>
        <!-- New-UI main toolbar: the app menu as a combo widget next to the VCS widget. Invisible unless
             the project's Mateu app has booted (i.e. a backend is configured) — see update(). -->
        <action id="io.mateu.AppToolbarWidget" class="io.mateu.ijp.plugin.MateuToolbarWidget"
                text="Mateu" description="Mateu application menu">
            <add-to-group group-id="MainToolbarLeft" anchor="last"/>
        </action>
        <!-- New | Mateu: one entry per specs/ui file kind (UI mount, routes, app shell, sources, page). -->
        <group id="io.mateu.NewGroup" class="io.mateu.ijp.newfile.MateuNewFileGroup">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </group>
        <!-- Add Route…: append one entry to a type: Routes file (shown only on such a file). -->
        <action id="io.mateu.AddRoute" class="io.mateu.ijp.newfile.AddMateuRouteAction"
                text="Add Mateu Route…" description="Append a route to this Mateu route registry (type: Routes)">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="NewGroup"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
