# Dashboard: a KPI band over a grid of titled panels, with sample data to replace with your own.
# The page is titled by its menu entry / window title. A MetricCard with an actionId is clickable.
type: VerticalLayout
pageType: dashboard
__PAGE_WIDTH__
fullWidth: true
horizontalAlignment: STRETCH
spacing: true
content:
  - type: Scoreboard
    metrics:
      - {type: MetricCard, title: Revenue, value: "1.2M", unit: EUR, trend: up, trendLabel: +8% vs last month}
      - {type: MetricCard, title: Orders, value: "3,480", trend: up, trendLabel: +3%}
      - {type: MetricCard, title: Returns, value: "1.9%", trend: down, trendLabel: -0.4 pts}
  - type: DashboardLayout
    columns: 2
    items:
      - type: DashboardPanel
        title: Sales by region
        subtitle: Last 6 months, thousands of EUR
        colSpan: 1
        content:
          type: Chart
          chartType: bar
          chartData:
            labels: [May, Jun, Jul, Aug, Sep, Oct]
            datasets:
              - {label: North, data: [120, 135, 128, 150, 162, 171]}
              - {label: South, data: [98, 104, 117, 121, 119, 133]}
      - type: DashboardPanel
        title: Latest orders
        subtitle: The five most recent
        colSpan: 1
        content:
          type: Grid
          compact: true
          content:
            - {type: GridColumn, id: order, label: Order}
            - {type: GridColumn, id: customer, label: Customer}
            - {type: GridColumn, id: total, label: Total, align: end}
            - {type: GridColumn, id: status, label: Status}
          page:
            content:
              - {order: SO-1042, customer: Acme Corp, total: "1,250.00", status: Shipped}
              - {order: SO-1041, customer: Globex, total: "860.50", status: Paid}
              - {order: SO-1040, customer: Initech, total: "2,310.00", status: Pending}
              - {order: SO-1039, customer: Umbrella, total: "412.75", status: Shipped}
              - {order: SO-1038, customer: Stark Ltd, total: "1,980.00", status: Paid}
