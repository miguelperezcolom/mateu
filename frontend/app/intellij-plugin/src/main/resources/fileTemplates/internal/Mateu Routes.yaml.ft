# Route registry of a mount. Each entry binds a route (relative to the mount; "" is its root)
# to a layout under specs/ui, an optional viewModel, and parameters it pins (fixedParams) or
# seeds (defaultParams); `children` nest sub-routes in a parent's slot. Add entries with
# Add Route…, see https://mateu.io/java-ui-definition/route-registry/
type: Routes
routes: []
