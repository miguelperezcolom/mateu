# Form page. Save and Cancel work as generated: Save checks the required fields and POSTs the form
# to the endpoint below; until that API exists its `sample:` answers instead (sample mode — the
# starters run in it, and the visual editor always does), so the user sees "Saved". Point `url` at
# your API (or name a sources.yaml entry with `ref:`), or bind a viewModel in routes.yaml and
# handle `save` there. See https://mateu.io/define/yaml/pages/
type: Form
title: __TITLE__
pageType: form
__PAGE_WIDTH__
# a page that edits asks before a navigation discards what was typed
confirmOnNavigationIfDirty: true
content:
  - type: FormLayout
    content:
      - {type: FormField, id: name, label: Name, dataType: string, required: true}
      - {type: FormField, id: email, label: Email, dataType: string, stereotype: email}
      - {type: FormField, id: birthDate, label: Birth date, dataType: date}
      - {type: FormField, id: notes, label: Notes, dataType: string, stereotype: textarea, colspan: 2}
buttons:
  - {type: Button, label: Cancel, actionId: cancel, buttonStyle: secondary}
  - {type: Button, label: Save, actionId: save, buttonStyle: primary}
actions:
  - id: save
    validationRequired: true
    restAction:
      source:
        url: /api/form
        method: POST
        sample: {}
      successMessage: Saved
  # Cancel drops what was typed and goes back to the app's home page
  - id: cancel
    steps:
      - type: MarkClean
      - type: Navigate
        route: ""
