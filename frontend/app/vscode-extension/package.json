{
  "name": "mateu-visual-editor",
  "displayName": "Mateu Visual Editor",
  "description": "Visual editor for Mateu YAML pages — palette + WYSIWYG canvas + properties, in one view. Shares the exact web bundle with the IntelliJ (JCEF) host.",
  "icon": "images/icon.png",
  "version": "0.1.0",
  "publisher": "miguelperezcolom",
  "license": "Apache-2.0",
  "homepage": "https://github.com/miguelperezcolom/mateu/tree/master/frontend/app/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/miguelperezcolom/mateu/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miguelperezcolom/mateu.git",
    "directory": "frontend/app/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mateu.visualEditor",
        "displayName": "Mateu Visual Editor",
        "selector": [
          {
            "filenamePattern": "**/specs/ui/*.yaml"
          },
          {
            "filenamePattern": "**/specs/ui/*.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Mateu Visual Editor",
      "properties": {
        "mateu.baseUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Mateu backend base URL, serving the reserved __preview__ / __contract__ sync actions. Point it at a running Mateu app (the starters and Spring Boot default to 8080; the repo's demo-starwars, with authored specs/ui pages, runs on http://localhost:8600)."
        },
        "mateu.renderer": {
          "type": "string",
          "enum": [
            "vaadin",
            "redwood"
          ],
          "default": "vaadin",
          "scope": "resource",
          "enumDescriptions": [
            "Vaadin (Lumo) — served by io.mateu:mateu-vaadin (the default)",
            "Redwood (Oracle Visual Builder) — served by io.mateu:mateu-redwood"
          ],
          "markdownDescription": "The renderer the whole project paints with. **Stored in `specs/ui/project.yaml`** (`type: Project`) — the file is the truth: changing this setting writes it, and the setting follows the file whenever it changes. The visual editor and Play open in it and the static bundle ships it; a served app renders with its Maven dependency (the server warns when the two disagree). Same as *Mateu: Project Settings…*."
        }
      }
    },
    "yamlValidation": [
      {
        "fileMatch": "**/specs/ui/**/*.yaml",
        "url": "./schema/specs-schema.json"
      },
      {
        "fileMatch": "**/specs/ui/**/*.yml",
        "url": "./schema/specs-schema.json"
      }
    ],
    "commands": [
      {
        "command": "mateu.newFile",
        "title": "New File…",
        "category": "Mateu"
      },
      {
        "command": "mateu.addRoute",
        "title": "Add Route…",
        "category": "Mateu"
      },
      {
        "command": "mateu.projectSettings",
        "title": "Project Settings…",
        "category": "Mateu"
      },
      {
        "command": "mateu.runLive",
        "title": "Run App (Live)",
        "category": "Mateu"
      },
      {
        "command": "mateu.reloadScreen",
        "title": "Reload Screen",
        "category": "Mateu"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mateu.newFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "mateu.addRoute",
          "when": "!explorerResourceIsFolder && resourcePath =~ /[\\\\/]specs[\\\\/]ui[\\\\/].*\\.ya?ml$/",
          "group": "navigation@11"
        }
      ],
      "editor/context": [
        {
          "command": "mateu.addRoute",
          "when": "mateu.isRoutesFile",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run stage && npm run compile",
    "stage": "node scripts/prepackage.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy:web": "cd ../../web/monorepo/apps/visual-editor && npm run build && rm -rf ../../../../app/vscode-extension/media && mkdir -p ../../../../app/vscode-extension/media && cp -rf dist/* ../../../../app/vscode-extension/media/",
    "test": "vitest run",
    "package": "vsce package --out mateu-visual-editor.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "activationEvents": [
    "workspaceContains:**/specs/ui/**/*.yaml",
    "workspaceContains:**/specs/ui/**/*.yml",
    "onCustomEditor:mateu.visualEditor",
    "onCommand:mateu.newFile",
    "onCommand:mateu.addRoute",
    "onCommand:mateu.projectSettings",
    "onCommand:mateu.runLive",
    "onCommand:mateu.reloadScreen"
  ],
  "keywords": [
    "mateu",
    "low-code",
    "yaml",
    "visual editor",
    "ui"
  ]
}
