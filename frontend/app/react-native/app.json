{
  "expo": {
    "name": "Mateu",
    "slug": "mateu-native",
    "scheme": "mateu",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.mateu.app",
      "buildNumber": "200003",
      "associatedDomains": [
        "applinks:mateu.io"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Mateu uses the camera to scan the QR codes that add apps to your list, and for photo fields in those apps.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.mateu.app",
      "versionCode": 200003,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mateu.io",
              "pathPrefix": "/add"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "mateu",
              "host": "add"
            },
            {
              "scheme": "mateu",
              "host": "import"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Mateu uses the camera to scan the QR codes that add apps to your list, and for photo fields in those apps.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/monochrome-icon.png",
          "color": "#2563EB",
          "defaultChannel": "mateu",
          "mode": "production"
        }
      ],
      "./plugins/with-async-storage-size"
    ],
    "extra": {
      "mateuRegistryUrl": "",
      "mateuAppId": "",
      "eas": {
        "projectId": "9f9dc6c1-4b4c-4524-9188-f9ab05f0bf50"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "miguelperezcolom",
    "updates": {
      "url": "https://u.expo.dev/9f9dc6c1-4b4c-4524-9188-f9ab05f0bf50",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
