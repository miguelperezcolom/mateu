{
  "appVersion": "1.0.1",
  "surface": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "host": "mateu.io",
              "pathPrefix": "/add",
              "scheme": "https"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "host": "add",
              "scheme": "mateu"
            },
            {
              "host": "import",
              "scheme": "mateu"
            }
          ]
        }
      ],
      "package": "io.mateu.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "associatedDomains": [
        "applinks:mateu.io"
      ],
      "bundleIdentifier": "io.mateu.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Mateu uses the camera to scan the QR codes that add apps to your list, and for photo fields in those apps."
      },
      "supportsTablet": true
    },
    "modules": {
      "@expo/dom-webview": "57.0.1",
      "@expo/log-box": "57.0.4",
      "@react-native-async-storage/async-storage": "2.2.0",
      "expo": "57.0.31",
      "expo-application": "57.0.3",
      "expo-asset": "57.0.20",
      "expo-camera": "57.0.6",
      "expo-constants": "57.0.23",
      "expo-crypto": "57.0.4",
      "expo-eas-client": "57.0.5",
      "expo-file-system": "57.0.7",
      "expo-font": "57.0.4",
      "expo-image": "57.0.5",
      "expo-image-loader": "57.0.1",
      "expo-image-picker": "57.0.20",
      "expo-json-utils": "57.0.2",
      "expo-keep-awake": "57.0.2",
      "expo-linking": "57.0.13",
      "expo-manifests": "57.0.2",
      "expo-modules-core": "57.0.24",
      "expo-modules-jsi": "57.1.3",
      "expo-notifications": "57.0.25",
      "expo-secure-store": "57.0.4",
      "expo-splash-screen": "57.0.10",
      "expo-status-bar": "57.0.1",
      "expo-structured-headers": "57.0.1",
      "expo-updates": "57.0.26",
      "expo-updates-interface": "57.0.2",
      "expo-web-browser": "57.0.3",
      "react-native-gesture-handler": "2.32.0",
      "react-native-reanimated": "4.5.1",
      "react-native-safe-area-context": "5.7.0",
      "react-native-screens": "4.26.2",
      "react-native-svg": "15.15.4",
      "react-native-view-shot": "5.1.0",
      "react-native-worklets": "0.10.1"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Mateu uses the camera to scan the QR codes that add apps to your list, and for photo fields in those apps.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-local-notifications-only",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "mateu",
          "icon": "./assets/monochrome-icon.png"
        }
      ],
      "./plugins/with-async-storage-size"
    ],
    "reactNative": "0.86.3",
    "scheme": "mateu"
  }
}
