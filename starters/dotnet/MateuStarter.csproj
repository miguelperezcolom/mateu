<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MateuStarter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mateu.NET, the same release as the Java artifacts (3.0-beta.N is 3.0.0-beta.N on NuGet).
         Inside the Mateu repository starters/Directory.Build.targets builds the sources instead. -->
    <PackageReference Include="Mateu.AspNetCore" Version="3.0.0-beta.64" />
    <PackageReference Include="Mateu.Uidl" Version="3.0.0-beta.64" />
  </ItemGroup>
</Project>
