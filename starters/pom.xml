<?xml version="1.0" encoding="UTF-8"?>
<!-- Aggregator so CI can build every Java starter in one command:
       mvn -f starters/pom.xml package -Dmateu.version=0.0.1-MATEU   (against the reactor)
       mvn -f starters/pom.xml package                               (against the latest release)
     Each starter is self-contained: copy one directory out of the repository and it builds on its
     own. Nothing here is inherited. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>mateu-starters</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>spring-mvc</module>
        <module>spring-webflux</module>
        <module>quarkus</module>
        <module>micronaut</module>
        <module>helidon-mp</module>
        <!-- YAML only: served by Spring Boot, and static (a bundle, no server) -->
        <module>yaml</module>
        <module>static</module>
    </modules>
</project>
