<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.mateu</groupId>
    <artifactId>mateu-shared-parent</artifactId>
    <version>0.0.1-MATEU</version>
  </parent>
  <artifactId>mateu-documents</artifactId>
  <packaging>jar</packaging>

  <name>Mateu documents</name>
  <description>Optional: renders HTML (a documented subset) to PDF for invoices, registration cards and
    reports — a DocumentRenderer bean on Apache PDFBox (Apache-2.0) and jsoup (MIT). Add this module
    only if your app produces documents.</description>

  <dependencies>
    <dependency>
      <groupId>io.mateu</groupId>
      <artifactId>mateu-uidl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Apache-2.0. Ships LiberationSans-Regular.ttf (SIL OFL 1.1), embedded as the default font. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <!-- MIT -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.21.1</version>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
