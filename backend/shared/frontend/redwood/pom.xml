<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.mateu</groupId>
        <artifactId>mateu-frontend-parent</artifactId>
        <version>0.0.1-MATEU</version>
    </parent>

    <artifactId>mateu-redwood</artifactId>
    <packaging>jar</packaging>

    <name>Mateu Redwood renderer</name>
    <description>The Mateu web renderer built on Oracle Visual Builder / Redwood, packaged as static assets served by the backend. Vendors nothing from Oracle: JET (UPL), the Spectra components and the Visual Builder runtime (Oracle proprietary, used under the user's own Oracle terms) load from Oracle's CDN at run time. Not affiliated with or endorsed by Oracle. See META-INF/NOTICE.md.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- git keeps ONE copy of the VB app (static/_redwood, served by Spring Boot, Micronaut
                 and Helidon from classpath static/); Quarkus serves only META-INF/resources, so the
                 jar gets a second copy there at build time. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <!-- what is Mateu's, what is Oracle's and what a user needs: shipped IN the jar (not
                         only in the repository), copied at build time from its single source -->
                    <execution>
                        <id>redwood-notice</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../../../frontend/web/monorepo/apps/redwood</directory>
                                    <includes>
                                        <include>NOTICE.md</include>
                                        <include>NOTICE.es.md</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>redwood-app-for-meta-inf-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources/_redwood</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/static/_redwood</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
