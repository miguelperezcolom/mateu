<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.mateu</groupId>
        <artifactId>frontend</artifactId>
        <version>0.0.1-MATEU</version>
    </parent>

    <artifactId>redwood</artifactId>
    <packaging>jar</packaging>

    <name>redwood</name>
    <description>Mateu renderer sobre Oracle Visual Builder / Redwood. Los recursos estáticos
        (la app VB optimizada) se generan con `npm run copy` desde
        frontend/web/monorepo/apps/redwood — no editar a mano. Los componentes JET/oj-sp y el
        visual-runtime se cargan del CDN de Oracle en runtime; este jar no los vendoriza
        (ver frontend/web/monorepo/apps/redwood/NOTICE.md).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- git keeps ONE copy of the VB app (static/_redwood, served by Spring Boot, Micronaut
                 and Helidon from classpath static/); Quarkus serves only META-INF/resources, so the
                 jar gets a second copy there at build time. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>redwood-app-for-meta-inf-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources/_redwood</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/resources/static/_redwood</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
