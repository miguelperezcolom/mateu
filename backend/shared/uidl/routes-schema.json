{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "$id" : "https://mateu.io/uidl/routes-schema.json",
  "version" : "3.0",
  "title" : "Mateu route registry",
  "description" : "JSON Schema for a mount's route file — a pure routing table binding each URL to a definition, a view model and its parameters. Routes are relative to the mount. GENERATED from RouteEntry by UidlSchemaGenerator — do not edit by hand.",
  "oneOf" : [ {
    "type" : "object",
    "properties" : {
      "type" : {
        "const" : "Routes"
      },
      "routes" : {
        "type" : "array",
        "items" : {
          "$ref" : "#/$defs/RouteEntry"
        }
      }
    },
    "required" : [ "routes" ]
  }, {
    "type" : "array",
    "items" : {
      "$ref" : "#/$defs/RouteEntry"
    }
  } ],
  "$defs" : {
    "RestDataSource" : {
      "type" : "object",
      "properties" : {
        "ref" : {
          "type" : "string"
        },
        "url" : {
          "type" : "string"
        },
        "method" : {
          "type" : "string"
        },
        "headers" : {
          "type" : "object"
        },
        "body" : {
          "type" : "string"
        },
        "itemsPath" : {
          "type" : "string"
        },
        "valuePath" : {
          "type" : "string"
        },
        "labelPath" : {
          "type" : "string"
        },
        "proxy" : {
          "type" : "boolean"
        }
      }
    },
    "RouteEntry" : {
      "type" : "object",
      "properties" : {
        "route" : {
          "type" : "string"
        },
        "definition" : {
          "type" : "string",
          "deprecated" : true,
          "description" : "Deprecated alias of `layout` — kept so existing routes.yaml files keep working. Prefer `layout`; if both are present, `layout` wins."
        },
        "viewModel" : {
          "type" : "string"
        },
        "fixedParams" : {
          "type" : "object"
        },
        "defaultParams" : {
          "type" : "object"
        },
        "parent" : {
          "type" : "string"
        },
        "children" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/RouteEntry"
          }
        },
        "state" : {
          "type" : "object"
        },
        "appState" : {
          "type" : "object"
        },
        "data" : {
          "$ref" : "#/$defs/RestDataSource"
        },
        "appData" : {
          "$ref" : "#/$defs/RestDataSource"
        },
        "layout" : {
          "type" : "string",
          "description" : "The UI definition (layout) this route renders — the canonical vocabulary of coherence-plan #5. May be omitted when the view model supplies its own tree. A definition shared by several routes lives in its own file and is named here."
        }
      }
    }
  }
}
