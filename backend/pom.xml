<?xml version="1.0" encoding="UTF-8"?>
<!-- The child.*.inherit.append.path="false" attributes keep url/scm as declared here in every
     module, instead of Maven appending each artifactId to them (a 404 per published module). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.mateu</groupId>
  <artifactId>mateu-parent</artifactId>
  <version>0.0.1-MATEU</version>
  <packaging>pom</packaging>

  <name>Mateu</name>
  <description>Mateu, a model-driven UI system: declare the model once (Java, C#, Python or YAML) and
    Mateu renders forms, CRUDs, wizards and app shells across web and native. Parent of the Java
    backend modules.</description>

  <url>https://github.com/miguelperezcolom/mateu</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/miguelperezcolom/mateu.git</connection>
    <developerConnection>scm:git:git@github.com:miguelperezcolom/mateu.git</developerConnection>
    <url>https://github.com/miguelperezcolom/mateu</url>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/miguelperezcolom/mateu/issues</url>
  </issueManagement>

  <developers>
    <developer>
      <id>miguelperezcolom</id>
      <name>Miguel Pérez Colom</name>
      <email>miguelperezcolom@gmail.com</email>
      <url>https://github.com/miguelperezcolom/</url>
      <organization>Mateu.io</organization>
      <organizationUrl>http://mateu.io</organizationUrl>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible builds: a fixed timestamp for every entry of every jar, so the same sources
         produce byte-identical artifacts (the release process may bump it). -->
    <project.build.outputTimestamp>2026-10-10T00:00:00Z</project.build.outputTimestamp>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <jacoco.min.coverage>0%</jacoco.min.coverage>
    <!-- Module-wide (BUNDLE) line-coverage floor; modules with real suites override it
         (backend/shared/core sets 70%). -->
    <jacoco.min.bundle.coverage>0%</jacoco.min.bundle.coverage>
    <!-- Public-API compatibility check (japicmp) of uidl, dtos and core's archetypes against the
         last RELEASED version. Report-only while the version is an alpha: set
         mateu.api.enforce=true (done from the beta tag on) and an incompatible change fails
         `mvn verify` unless the type/member is @Experimental or listed in
         api-compat/japicmp-exclusions.properties. See reference/stability-and-versioning.md. -->
    <mateu.japicmp.baseline>3.0-alpha.408</mateu.japicmp.baseline>
    <!-- THE beta switch: `-Dmateu.api.enforce=true` (or flipping this default at the beta tag)
         makes an incompatible change to the non-@Experimental surface fail the build.
         mateu.japicmp.enforce is the knob the plugin reads; it follows this one. -->
    <mateu.api.enforce>false</mateu.api.enforce>
    <mateu.japicmp.enforce>${mateu.api.enforce}</mateu.japicmp.enforce>
    <mateu.japicmp.skip>false</mateu.japicmp.skip>
  </properties>

  <modules>
    <module>shared</module>
    <module>webflux</module>
    <module>micronaut</module>
    <module>quarkus</module>
    <module>mvc</module>
    <module>helidon-mp</module>
    <module>mateu-bundle-maven-plugin</module>
    <!-- not a child of this pom (see its header): only aggregated, so it is built and released
         with the rest -->
    <module>mateu-bom</module>
    <!-- pom-only artifacts at the pre-rename ids (io.mateu:mvc-core…) relocating to mateu-* -->
    <module>relocations</module>
    <!-- New project from the command line, assembled from ../starters (see its pom). Last: its
         integration test packages generated projects against the artifacts installed above. -->
    <module>mateu-archetype</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!--
        Pin Lombok ahead of the Spring Boot BOM. spring-boot-starter-parent 3.3.4 manages
        Lombok to 1.18.34, which crashes on newer JDKs (e.g. JDK 25:
        "com.sun.tools.javac.code.TypeTag :: UNKNOWN"). A directly declared managed dependency
        wins over one from an imported BOM, so this bumps every module — including the framework
        adapters that pick Lombok up transitively from the classpath rather than pinning it in
        their own annotationProcessorPaths. (Overriding the lombok.version property does NOT work
        here because spring-boot-starter-parent is imported as a BOM, not used as the parent.)
      -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>1.18.46</version>
      </dependency>
      <!--
        Pin smallrye-common-function ahead of the Quarkus BOM. Quarkus 3.38 pulls it at 2.14.0 via
        jboss-threads and at 2.19.0 via smallrye-common-io, which the maven-enforcer
        DependencyConvergence rule rejects. A directly declared managed dependency converges every
        path on 2.19.0.
      -->
      <dependency>
        <groupId>io.smallrye.common</groupId>
        <artifactId>smallrye-common-function</artifactId>
        <version>2.19.0</version>
      </dependency>
      <!--
        Pin hibernate-validator to the Spring Boot 4 line (9.1.2.Final) everywhere. Spring Boot 4.1.0
        brings jakarta-validation 3.x / hibernate-validator 9.x; core and webflux-core also declare it
        directly (bumped to 9.1.2 in their poms), and this managed pin converges the modules that
        pick it up transitively from the Boot BOM, keeping maven-enforcer DependencyConvergence happy.
      -->
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>9.1.2.Final</version>
      </dependency>
      <!--
        Pin Apache Groovy to the line rest-assured expects (4.0.22). rest-assured 5.5.0 (test scope)
        pulls groovy/groovy-json/groovy-xml at 4.0.22, but the Spring Boot 4.1 BOM manages them up to
        5.0.6. rest-assured's Groovy-based HTTPBuilder is not compatible with Groovy 5 — plain GET
        requests blow up with a NullPointerException deep in the Groovy metaclass machinery
        (io.mateu.integrationtests.GetIndexIT). Groovy is a test-only transitive here (nothing in the
        backend uses it at runtime), so a directly managed pin back to 4.0.22 fixes the ITs with no
        runtime impact.
      -->
      <dependency>
        <groupId>org.apache.groovy</groupId>
        <artifactId>groovy</artifactId>
        <version>6.0.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.groovy</groupId>
        <artifactId>groovy-json</artifactId>
        <version>6.0.0</version>
      </dependency>
      <dependency>
        <groupId>org.apache.groovy</groupId>
        <artifactId>groovy-xml</artifactId>
        <version>6.0.0</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>annotations</artifactId>
      <version>3.0.1</version>
    </dependency>

  </dependencies>

  <build>
          <pluginManagement>
              <plugins>
                  <plugin>
                      <groupId>org.apache.maven.plugins</groupId>
                      <artifactId>maven-surefire-plugin</artifactId>
                      <version>3.5.6</version> </plugin>
                  <!-- Loads the reviewed API-compatibility exclusions (one property, a ';' list). -->
                  <plugin>
                      <groupId>org.codehaus.mojo</groupId>
                      <artifactId>properties-maven-plugin</artifactId>
                      <version>1.2.1</version>
                      <executions>
                          <execution>
                              <id>japicmp-exclusions</id>
                              <phase>initialize</phase>
                              <goals><goal>read-project-properties</goal></goals>
                              <configuration>
                                  <files>
                                      <file>${project.basedir}/../../api-compat/japicmp-exclusions.properties</file>
                                  </files>
                              </configuration>
                          </execution>
                      </executions>
                  </plugin>
                  <!-- The public-API compatibility check; a module opts in by declaring the plugin
                       (and properties-maven-plugin above) in its <plugins>, giving the old artifact
                       and, for core, the packages that are public. -->
                  <plugin>
                      <groupId>com.github.siom79.japicmp</groupId>
                      <artifactId>japicmp-maven-plugin</artifactId>
                      <version>0.26.3</version>
                      <executions>
                          <execution>
                              <id>api-compatibility</id>
                              <phase>verify</phase>
                              <goals><goal>cmp</goal></goals>
                          </execution>
                      </executions>
                      <configuration>
                          <skip>${mateu.japicmp.skip}</skip>
                          <newVersion>
                              <file>
                                  <path>${project.build.directory}/${project.build.finalName}.${project.packaging}</path>
                              </file>
                          </newVersion>
                          <parameter>
                              <onlyModified>true</onlyModified>
                              <accessModifier>protected</accessModifier>
                              <ignoreMissingClasses>true</ignoreMissingClasses>
                              <breakBuildOnBinaryIncompatibleModifications>${mateu.japicmp.enforce}</breakBuildOnBinaryIncompatibleModifications>
                              <breakBuildOnSourceIncompatibleModifications>${mateu.japicmp.enforce}</breakBuildOnSourceIncompatibleModifications>
                              <excludes>
                                  <exclude>@io.mateu.uidl.annotations.Experimental</exclude>
                                  <exclude>${japicmp.reviewedExcludes}</exclude>
                              </excludes>
                              <skipHtmlReport>false</skipHtmlReport>
                              <skipMarkdownReport>false</skipMarkdownReport>
                          </parameter>
                      </configuration>
                  </plugin>
              </plugins>
          </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>

          <compilerArgs>
            <!--
            <arg>-verbose</arg>
            <arg>-Xlint:all,-options,-path</arg>
            -->
            <arg>-parameters</arg>
          </compilerArgs>

        </configuration>
        <executions>
          <!-- Replacing default-compile as it is treated specially by maven -->
          <execution>
            <id>default-compile</id>
            <phase>none</phase>
          </execution>
          <!-- Replacing default-testCompile as it is treated specially by maven -->
          <execution>
            <id>default-testCompile</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>java-compile</id>
            <phase>compile</phase>
            <goals> <goal>compile</goal> </goals>
          </execution>
          <execution>
            <id>java-test-compile</id>
            <phase>test-compile</phase>
            <goals> <goal>testCompile</goal> </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <rules>
            <bannedDependencies>
            </bannedDependencies>
            <dependencyConvergence/>
          </rules>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
        </executions>
      </plugin>







      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add_sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/main/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <sourcepath>src/main/java</sourcepath>
          <source>21</source>
          <doclint>none</doclint>
          <failOnError>false</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>


      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.8</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals>
              <goal>sign</goal>
            </goals>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.11.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
          <!-- the release job only succeeds once Maven Central has actually published the bundle
               (not merely accepted the upload); give up after an hour -->
          <waitUntil>published</waitUntil>
          <waitMaxTime>3600</waitMaxTime>
          <!-- internal modules: built and tested, never published (each also sets
               maven.deploy.skip) -->
          <excludeArtifacts>
            <artifact>integration-tests</artifact>
          </excludeArtifacts>
        </configuration>
      </plugin>

<!--
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <configuration>
          <java>
            <removeUnusedImports/>
            <googleJavaFormat/>
          </java>
        </configuration>
      </plugin>
-->
      <plugin>
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <version>2.29</version>
        <executions>
          <execution>
            <goals>
              <goal>format</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.8.6.0</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      -->

      <!--
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>7.1.1</version>
        <configuration>
          <suppressionFiles>
            <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
          </suppressionFiles>
          <failBuildOnCVSS>8</failBuildOnCVSS>
          <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
          <failOnError>true</failOnError>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      -->

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Excluded from coverage: thin wrappers over live HTTP that cannot run in-JVM.
               RemoteMenuHandler resolves federated menus against a REMOTE Mateu backend (the
               frontend performs the fetch in normal operation); DefaultMateuHttpClient is the
               java.net.http adapter behind it. Both are exercised by the e2e suites instead. -->
          <excludes>
            <exclude>io/mateu/core/infra/out/DefaultMateuHttpClient*</exclude>
            <exclude>io/mateu/core/application/runaction/RemoteMenuHandler*</exclude>
          </excludes>
          <rules>
            <rule>
              <element>PACKAGE</element>
              <limits>
                <limit>
                  <counter>LINE</counter>
                  <value>COVEREDRATIO</value>
                  <minimum>${jacoco.min.coverage}</minimum>
                </limit>
              </limits>
            </rule>
            <rule>
              <element>BUNDLE</element>
              <limits>
                <limit>
                  <counter>LINE</counter>
                  <value>COVEREDRATIO</value>
                  <minimum>${jacoco.min.bundle.coverage}</minimum>
                </limit>
              </limits>
            </rule>
          </rules>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
