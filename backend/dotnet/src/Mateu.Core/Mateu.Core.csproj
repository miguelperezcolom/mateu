<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Mateu.Core</PackageId>
    <Description>Mateu engine for .NET: route registry, reflection mapper (view model to component tree), action dispatch and the /mateu/v3/sync use case.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API docs are welcome but not yet complete: a missing XML comment must not fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Mateu.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine is internal (3.0-alpha.429): only the authoring/app-facing API is public — see
         README "Public API" and PublicSurfaceTests. The adapter and the test suite see the rest. -->
    <InternalsVisibleTo Include="Mateu.AspNetCore" />
    <InternalsVisibleTo Include="Mateu.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mateu.Uidl/Mateu.Uidl.csproj" />
    <ProjectReference Include="../Mateu.Dtos/Mateu.Dtos.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- The MCP authoring contract (schemas, component catalogue, agent guide), served verbatim:
         LINKED to the generated files of backend/shared/uidl — never copied, so the four
         implementations serve the same bytes (conformance/mcp/README.md). -->
    <EmbeddedResource Include="../../../shared/uidl/uidl-schema.json" LogicalName="Mateu.Authoring.uidl-schema.json" Link="Authoring/uidl-schema.json" />
    <EmbeddedResource Include="../../../shared/uidl/specs-schema.json" LogicalName="Mateu.Authoring.specs-schema.json" Link="Authoring/specs-schema.json" />
    <EmbeddedResource Include="../../../shared/uidl/uidl-catalog.json" LogicalName="Mateu.Authoring.uidl-catalog.json" Link="Authoring/uidl-catalog.json" />
    <EmbeddedResource Include="../../../shared/uidl/authoring-guide.md" LogicalName="Mateu.Authoring.authoring-guide.md" Link="Authoring/authoring-guide.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- The PWA's files (Pwa.cs): byte-identical copies of Java's
         backend/shared/core/src/main/resources/io/mateu/core/infra/pwa/ (PwaTests compares them). -->
    <EmbeddedResource Include="PwaFiles/sw.js" LogicalName="Mateu.Pwa.sw.js" />
    <EmbeddedResource Include="PwaFiles/sw-off.js" LogicalName="Mateu.Pwa.sw-off.js" />
    <EmbeddedResource Include="PwaFiles/register.js" LogicalName="Mateu.Pwa.register.js" />
    <EmbeddedResource Include="PwaFiles/icon-192.png" LogicalName="Mateu.Pwa.icon-192.png" />
    <EmbeddedResource Include="PwaFiles/icon-512.png" LogicalName="Mateu.Pwa.icon-512.png" />
    <EmbeddedResource Include="PwaFiles/icon-maskable-512.png" LogicalName="Mateu.Pwa.icon-maskable-512.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>
