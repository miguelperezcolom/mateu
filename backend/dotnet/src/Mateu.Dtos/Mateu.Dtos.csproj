<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Mateu.Dtos</PackageId>
    <Description>Mateu wire model for .NET: the UIIncrement/component DTOs exchanged with every Mateu renderer, serialized to exactly the JSON the Java reference emits.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API docs are welcome but not yet complete: a missing XML comment must not fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Mateu.Dtos</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>
