<?xml version="1.0" encoding="UTF-8"?>
<!-- io.mateu:mateu-archetype — a new Mateu project from the command line:

       mvn archetype:generate -DarchetypeGroupId=io.mateu -DarchetypeArtifactId=mateu-archetype \
           -DarchetypeVersion=<release> -DgroupId=com.acme -DartifactId=my-app \
           -Dauthoring=code|yaml|static -Drenderer=vaadin|redwood

     NO hand-kept template: the archetype is assembled at build time from the repository's starters
     (starters/spring-mvc for `code`, starters/yaml, starters/static — compiled and booted by CI) and
     the generator data shared with the IDE wizards (starters/generator/new-project.json, whose
     replacements META-INF/archetype-post-generate.groovy applies). The generated project depends on
     the archetype's own version of Mateu. The integration test (src/test/resources/projects/*)
     generates each flavour and packages it. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.mateu</groupId>
    <artifactId>mateu-parent</artifactId>
    <version>0.0.1-MATEU</version>
  </parent>

  <artifactId>mateu-archetype</artifactId>
  <packaging>maven-archetype</packaging>
  <name>Mateu project archetype</name>
  <description>Creates a new Mateu project: code (@UI classes on Spring Boot), YAML only served by Spring
    Boot, or YAML only as a static bundle with no backend. Built from the official starters.</description>

  <properties>
    <starters>${project.basedir}/../../starters</starters>
    <archetype.test.skip>false</archetype.test.skip>
    <archetype.resources>${project.build.directory}/generated-archetype/archetype-resources</archetype.resources>
  </properties>

  <!-- Test-scoped only to order the reactor: the integration test packages generated projects that
       depend on these, so they must be installed first. -->
  <dependencies>
    <dependency>
      <groupId>io.mateu</groupId>
      <artifactId>mateu-mvc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.mateu</groupId>
      <artifactId>mateu-vaadin</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.mateu</groupId>
      <artifactId>mateu-annotation-processor-mvc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.mateu</groupId>
      <artifactId>mateu-bundle-maven-plugin</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.4.1</version>
      </extension>
    </extensions>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-archetype</directory>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>variant-code</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${archetype.resources}/variants/code</outputDirectory>
              <resources>
                <resource>
                  <directory>${starters}/spring-mvc</directory>
                  <excludes><exclude>target/**</exclude></excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>variant-yaml</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${archetype.resources}/variants/yaml</outputDirectory>
              <resources>
                <resource>
                  <directory>${starters}/yaml</directory>
                  <excludes><exclude>target/**</exclude></excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>variant-static</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${archetype.resources}/variants/static</outputDirectory>
              <addDefaultExcludes>false</addDefaultExcludes>
              <resources>
                <resource>
                  <directory>${starters}/static</directory>
                  <excludes><exclude>target/**</exclude></excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>generator-data</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${archetype.resources}/generator</outputDirectory>
              <resources>
                <resource>
                  <directory>${starters}/generator</directory>
                  <includes>
                    <include>new-project.json</include>
                    <include>overlays/common/**</include>
                    <include>overlays/java/redwood/**</include>
                    <include>overlays/java/empty/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- The Mateu version the generated project depends on: this archetype's own. -->
          <execution>
            <id>mateu-version</id>
            <phase>generate-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${archetype.resources}/generator</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/archetype-templates</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <!-- -Dmaven.test.skip / -DskipTests also skip generating and packaging the sample projects -->
          <skip>${archetype.test.skip}</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>skip-archetype-it-on-maven-test-skip</id>
      <activation><property><name>maven.test.skip</name></property></activation>
      <properties><archetype.test.skip>true</archetype.test.skip></properties>
    </profile>
    <profile>
      <id>skip-archetype-it-on-skip-tests</id>
      <activation><property><name>skipTests</name></property></activation>
      <properties><archetype.test.skip>true</archetype.test.skip></properties>
    </profile>
  </profiles>
</project>
