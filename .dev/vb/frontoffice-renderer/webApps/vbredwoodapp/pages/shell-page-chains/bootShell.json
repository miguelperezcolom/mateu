{
  "description": "Arranca el shell: carga menu (nav) + primera ruta de contenido.",
  "root": "loadApp",
  "variables": {},
  "actions": {
    "loadApp": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": { "module": "[[ $application.functions ]]", "functionName": "loadApp" },
      "outcomes": { "success": "loadRoute" }
    },
    "loadRoute": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": { "module": "[[ $application.functions ]]", "functionName": "loadRoute", "params": ["{{ $chain.results.loadApp.firstRoute }}"] },
      "outcomes": { "success": "assign" }
    },
    "assign": { "module": "vb/action/builtin/assignVariablesAction", "parameters": {
  "$application.variables.greeting": { "source": "{{ $chain.results.loadRoute.greeting }}" },
  "$application.variables.isForm": { "source": "{{ $chain.results.loadRoute.isForm }}" },
  "$application.variables.isTable": { "source": "{{ $chain.results.loadRoute.isTable }}" },
  "$application.variables.isCrud": { "source": "{{ $chain.results.loadRoute.isCrud }}" },
  "$application.variables.isFoldout": { "source": "{{ $chain.results.loadRoute.isFoldout }}" },
  "$application.variables.saveMsg": { "source": "{{ '' }}" }
} }
  }
}
