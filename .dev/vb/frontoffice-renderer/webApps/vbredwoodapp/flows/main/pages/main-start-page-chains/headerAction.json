{
  "description": "Fase 6: dispara una acción de cabecera (app-level) y muestra su mensaje.",
  "root": "go",
  "variables": { "event": { "required": true, "type": "any", "input": "fromCaller" } },
  "actions": {
    "go": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": { "module": "[[ $functions ]]", "functionName": "headerAction", "params": ["{{ $variables.event }}"] },
      "outcomes": { "success": "assign" }
    },
    "assign": {
      "module": "vb/action/builtin/assignVariablesAction",
      "parameters": { "$page.variables.headerMsg": { "source": "{{ $chain.results.go.message }}" } }
    }
  }
}
