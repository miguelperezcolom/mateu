{
  "description": "Fases 2–3: carga la App (menú) y el contenido de la primera ruta (Text o formulario).",
  "root": "loadApp",
  "variables": {},
  "actions": {
    "loadApp": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": {
        "module": "[[ $functions ]]",
        "functionName": "loadApp"
      },
      "outcomes": {
        "success": "loadRoute"
      }
    },
    "loadRoute": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": {
        "module": "[[ $functions ]]",
        "functionName": "loadRoute",
        "params": [
          "{{ $chain.results.loadApp.firstRoute }}"
        ]
      },
      "outcomes": {
        "success": "assign"
      }
    },
    "assign": {
      "module": "vb/action/builtin/assignVariablesAction",
      "parameters": {
        "$page.variables.greeting": {
          "source": "{{ $chain.results.loadRoute.greeting }}"
        },
        "$page.variables.isForm": {
          "source": "{{ $chain.results.loadRoute.isForm }}"
        },
        "$page.variables.saveMsg": {
          "source": "{{ '' }}"
        }
      }
    }
  }
}
