{
  "description": "Fase 5: cancela el form y vuelve al listado.",
  "root": "go",
  "variables": {},
  "actions": {
    "go": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": { "module": "[[ $functions ]]", "functionName": "backToList" },
      "outcomes": { "success": "assign" }
    },
    "assign": {
      "module": "vb/action/builtin/assignVariablesAction",
      "parameters": {
        "$page.variables.isForm": { "source": "{{ $chain.results.go.isForm }}" },
        "$page.variables.isTable": { "source": "{{ $chain.results.go.isTable }}" },
        "$page.variables.saveMsg": { "source": "{{ '' }}" }
      }
    }
  }
}
