{
  "description": "Fase 8: boton primario del guided-process → avanza el wizard (next/completar).",
  "root": "go",
  "variables": {},
  "actions": {
    "go": { "module": "vb/action/builtin/callModuleFunctionAction", "parameters": { "module": "[[ $application.functions ]]", "functionName": "guidedPrimary" }, "outcomes": { "success": "assign" } },
    "assign": { "module": "vb/action/builtin/assignVariablesAction", "parameters": {
        "$application.variables.isWizard": { "source": "{{ $chain.results.go.isWizard }}" },
        "$application.variables.isForm": { "source": "{{ $chain.results.go.isForm }}" },
        "$application.variables.isFoldout": { "source": "{{ $chain.results.go.isFoldout }}" },
        "$application.variables.isTable": { "source": "{{ $chain.results.go.isTable }}" },
        "$application.variables.greeting": { "source": "{{ $chain.results.go.greeting }}" }
      } }
  }
}
