{
  "description": "Fase 2: al seleccionar una opción del navigator, recarga SOLO el contenido de esa ruta.",
  "root": "loadRoute",
  "variables": {
    "selection": {
      "required": true,
      "type": "any",
      "input": "fromCaller"
    }
  },
  "actions": {
    "loadRoute": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": {
        "module": "[[ $functions ]]",
        "functionName": "loadRoute",
        "params": [
          "{{ $variables.selection }}"
        ]
      },
      "outcomes": {
        "success": "assign"
      }
    },
    "assign": {
      "module": "vb/action/builtin/assignVariablesAction",
      "parameters": {
        "$page.variables.greeting": {
          "source": "{{ $chain.results.loadRoute.greeting }}"
        }
      }
    }
  }
}
