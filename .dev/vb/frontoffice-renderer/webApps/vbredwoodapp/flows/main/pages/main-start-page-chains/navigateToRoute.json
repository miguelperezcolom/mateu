{
  "description": "Fases 2–3: al seleccionar una opción, recarga SOLO el contenido (Text o formulario).",
  "root": "loadRoute",
  "variables": {
    "selection": {
      "required": true,
      "type": "any",
      "input": "fromCaller"
    }
  },
  "actions": {
    "loadRoute": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": {
        "module": "[[ $functions ]]",
        "functionName": "loadRoute",
        "params": [
          "{{ $variables.selection }}"
        ]
      },
      "outcomes": {
        "success": "assign"
      }
    },
    "assign": {
      "module": "vb/action/builtin/assignVariablesAction",
      "parameters": {
        "$page.variables.greeting": {
          "source": "{{ $chain.results.loadRoute.greeting }}"
        },
        "$page.variables.isForm": {
          "source": "{{ $chain.results.loadRoute.isForm }}"
        },
        "$page.variables.isTable": {
          "source": "{{ $chain.results.loadRoute.isTable }}"
        },
        "$page.variables.isCrud": {
          "source": "{{ $chain.results.loadRoute.isCrud }}"
        },
        "$page.variables.saveMsg": {
          "source": "{{ '' }}"
        },
        "$page.variables.isFoldout": {
          "source": "{{ $chain.results.loadRoute.isFoldout }}"
        }
      }
    }
  }
}