{
  "description": "Fase 3/5: guarda el form. En crud (create/edit) vuelve al listado; si no, muestra el mensaje.",
  "root": "save",
  "variables": {},
  "actions": {
    "save": {
      "module": "vb/action/builtin/callModuleFunctionAction",
      "parameters": {
        "module": "[[ $functions ]]",
        "functionName": "save"
      },
      "outcomes": {
        "success": "assign"
      }
    },
    "assign": {
      "module": "vb/action/builtin/assignVariablesAction",
      "parameters": {
        "$page.variables.saveMsg": {
          "source": "{{ $chain.results.save.message }}"
        },
        "$page.variables.isForm": {
          "source": "{{ $chain.results.save.isForm }}"
        },
        "$page.variables.isTable": {
          "source": "{{ $chain.results.save.isTable }}"
        }
      }
    }
  }
}
