{
  "description": "Fase 9: CTA de Welcome → dispatch de su actionId; el mensaje se muestra como toast.",
  "root": "go",
  "variables": { "event": { "required": true, "type": "any", "input": "fromCaller" } },
  "actions": {
    "go": { "module": "vb/action/builtin/callModuleFunctionAction", "parameters": { "module": "[[ $application.functions ]]", "functionName": "welcomeAction", "params": ["{{ $variables.event }}"] }, "outcomes": { "success": "assign" } },
    "assign": { "module": "vb/action/builtin/assignVariablesAction", "parameters": {
        "$application.variables.headerMsg": { "source": "{{ $chain.results.go.message }}" }
      } }
  }
}
