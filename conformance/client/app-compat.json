{
  "$comment": "Can THIS hub app render that UI? Run by the React Native app (src/hub/compat.conformance.test.ts) and the IntelliJ desktop app (AppCompatConformanceTest). The app side is what the app knows of itself: the wire it was built for, the Mateu release its renderer comes from (null = unknown, e.g. a local build) and its own app version (what minAppVersion speaks of). The ui side is the UI's manifest. status: compatible (open), recommended (open, suggest updating the app: it may lack components that UI sends), required (do not add or open: offer the update). The FIRST reason that applies wins, in this order: newerWire, olderWire, minAppVersion, newerMinor, newerMateu.",
  "cases": [
    { "name": "same release", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "3.0", "minAppVersion": "1.0.0", "mateuVersion": "3.0-beta.33" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "a server that predates the fields", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": {}, "expect": { "status": "compatible", "reason": null } },
    { "name": "the old one-digit wire spelling", "app": { "wire": "3.0", "mateuVersion": null, "appVersion": "1.0.0" }, "ui": { "wireVersion": "3" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "a newer wire major", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "4.0" }, "expect": { "status": "required", "reason": "newerWire" } },
    { "name": "an older wire major (the server must be updated)", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "2" }, "expect": { "status": "required", "reason": "olderWire" } },
    { "name": "minAppVersion above this app", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.9" }, "ui": { "wireVersion": "3.0", "minAppVersion": "1.2.0" }, "expect": { "status": "required", "reason": "minAppVersion" } },
    { "name": "minAppVersion compares numerically", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.10.0" }, "ui": { "minAppVersion": "1.2.0" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "a newer wire minor", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "3.4" }, "expect": { "status": "recommended", "reason": "newerMinor" } },
    { "name": "an older wire minor is fine", "app": { "wire": "3.4", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "3.0" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "a newer Mateu release", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "3.0", "mateuVersion": "3.0-beta.34" }, "expect": { "status": "recommended", "reason": "newerMateu" } },
    { "name": "an older Mateu release is fine", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0-beta.20" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "an app that does not know its release", "app": { "wire": "3.0", "mateuVersion": null, "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0-beta.34" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "a Python release (PEP 440) is newer", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0.0b34" }, "expect": { "status": "recommended", "reason": "newerMateu" } },
    { "name": "a .NET release (semver) is the same", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0.0-beta.33" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "alpha < beta", "app": { "wire": "3.0", "mateuVersion": "3.0-alpha.430", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0-beta.1" }, "expect": { "status": "recommended", "reason": "newerMateu" } },
    { "name": "rc < GA", "app": { "wire": "3.0", "mateuVersion": "3.0-rc.2", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0.0" }, "expect": { "status": "recommended", "reason": "newerMateu" } },
    { "name": "a GA app is newer than a beta UI", "app": { "wire": "3.0", "mateuVersion": "3.0.0", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.0-beta.40" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "a newer minor release", "app": { "wire": "3.0", "mateuVersion": "3.0.4", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "3.1.0" }, "expect": { "status": "recommended", "reason": "newerMateu" } },
    { "name": "a version that names no release is ignored", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "mateuVersion": "0.0.1-MATEU" }, "expect": { "status": "compatible", "reason": null } },
    { "name": "the wire is decided first", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "4.0", "minAppVersion": "9.0.0" }, "expect": { "status": "required", "reason": "newerWire" } },
    { "name": "required beats recommended", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "minAppVersion": "2.0.0", "mateuVersion": "3.0-beta.34" }, "expect": { "status": "required", "reason": "minAppVersion" } },
    { "name": "a newer minor is named before a newer release", "app": { "wire": "3.0", "mateuVersion": "3.0-beta.33", "appVersion": "1.0.0" }, "ui": { "wireVersion": "3.1", "mateuVersion": "3.0-beta.34" }, "expect": { "status": "recommended", "reason": "newerMinor" } }
  ]
}
