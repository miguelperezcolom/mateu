{
  "description": "How a renderer words a running task's ETA (ProgressDto.etaSeconds, computed by the server — see conformance/progress/eta.json). null/absent, or a value <= 0, shows NOTHING (never a guess). Every language of the chrome catalogues (en, es, fr, de, pt, it). Run by libs/mateu (the reference, chromeTexts taskEtaUnderMinute/taskEtaMinutes/taskEtaHours), Redwood (poc/i18n.mjs), React Native and IntelliJ.",
  "rules": [
    "etaSeconds null, absent, not a number or <= 0: no text",
    "etaSeconds < 60: under a minute",
    "etaSeconds < 3600: n = max(1, round(etaSeconds / 60)) minutes (round half up); a rounded 60 reads as hours",
    "otherwise: n = max(1, round(etaSeconds / 3600)) hours (round half up)"
  ],
  "texts": {
    "en": { "underMinute": "less than a minute left", "minutes": "about {n} min left", "hours": "about {n} h left" },
    "es": { "underMinute": "menos de un minuto", "minutes": "unos {n} min restantes", "hours": "unas {n} h restantes" },
    "fr": { "underMinute": "moins d'une minute restante", "minutes": "environ {n} min restantes", "hours": "environ {n} h restantes" },
    "de": { "underMinute": "noch weniger als eine Minute", "minutes": "noch etwa {n} Min.", "hours": "noch etwa {n} Std." },
    "pt": { "underMinute": "menos de um minuto", "minutes": "cerca de {n} min restantes", "hours": "cerca de {n} h restantes" },
    "it": { "underMinute": "meno di un minuto", "minutes": "circa {n} min rimanenti", "hours": "circa {n} h rimanenti" }
  },
